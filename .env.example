# BGP Looking Glass Configuration
# Copy this file to .env and customize

# Application settings
LG_APP_NAME="BGP Looking Glass"
LG_DEBUG=false

# Inventory file path
LG_INVENTORY_PATH=inventory/hosts.yml

# Network timeouts (seconds)
LG_CONNECTION_TIMEOUT=30
LG_COMMAND_TIMEOUT=60
LG_MAX_CONCURRENT_COMMANDS_PER_SWITCH=2

# Default credentials (can be overridden per-device in inventory)
LG_DEFAULT_USERNAME=admin
LG_DEFAULT_PASSWORD=

# Security
LG_SECRET_KEY=change-me-in-production-use-strong-random-value
